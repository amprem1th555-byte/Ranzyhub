local function addWalkSpeedSlider()
	local card=addCard(78)

	local valueLabel=Instance.new("TextLabel",card)
	valueLabel.Position=UDim2.fromOffset(16,8)
	valueLabel.Size=UDim2.new(1,-32,0,25)
	valueLabel.BackgroundTransparency=1
	valueLabel.Text="WalkSpeed                         "..currentSpeed
	valueLabel.TextColor3=TEXT
	valueLabel.TextSize=15
	valueLabel.Font=Enum.Font.GothamMedium
	valueLabel.TextXAlignment=Enum.TextXAlignment.Left

	local bar=Instance.new("Frame",card)
	bar.Position=UDim2.fromOffset(16,47)
	bar.Size=UDim2.new(1,-32,0,7)
	bar.BackgroundColor3=Color3.fromRGB(50,51,60)
	bar.BorderSizePixel=0
	Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)

	local p=(currentSpeed-1)/99

	local fill=Instance.new("Frame",bar)
	fill.Size=UDim2.new(p,0,1,0)
	fill.BackgroundColor3=PURPLE
	fill.BorderSizePixel=0
	Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

	local knob=Instance.new("TextButton",bar)
	knob.Size=UDim2.fromOffset(19,19)
	knob.Position=UDim2.new(p,-9,.5,-9)
	knob.BackgroundColor3=Color3.fromRGB(240,240,245)
	knob.Text=""
	Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

	local dragging=false

	local function setValue(x)
		local percent=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
		currentSpeed=math.floor(1+percent*99+.5)
		fill.Size=UDim2.new(percent,0,1,0)
		knob.Position=UDim2.new(percent,-9,.5,-9)
		valueLabel.Text="WalkSpeed                         "..currentSpeed
		applyWalkSpeed()
	end

	knob.MouseButton1Down:Connect(function() dragging=true end)

	bar.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
			or input.UserInputType==Enum.UserInputType.Touch then
			dragging=true
			setValue(input.Position.X)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement
			or input.UserInputType==Enum.UserInputType.Touch) then
			setValue(input.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
			or input.UserInputType==Enum.UserInputType.Touch then
			dragging=false
		end
	end)
end

local function setNoclip(state)
	noclipEnabled=state
	if not state then
		local c=Player.Character
		if c then
			for _,v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") then v.CanCollide=true end
			end
		end
	end
end

RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	local c=Player.Character
	if c then
		for _,v in ipairs(c:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide=false end
		end
	end
end)

local function setXRay(state)
	xrayEnabled=state

	if state then
		for _,v in ipairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") and not (Player.Character and v:IsDescendantOf(Player.Character)) then
				if originalTransparency[v]==nil then
					originalTransparency[v]=v.LocalTransparencyModifier
				end
				v.LocalTransparencyModifier=.65
			end
		end
	else
		for obj,value in pairs(originalTransparency) do
			if obj and obj.Parent then obj.LocalTransparencyModifier=value end
		end
		table.clear(originalTransparency)
	end
end

local function removeESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Character then
			local h=p.Character:FindFirstChild("RAN_ESP")
			if h then h:Destroy() end

			local head=p.Character:FindFirstChild("Head")
			if head then
				local b=head:FindFirstChild("RAN_ESP_INFO")
				if b then b:Destroy() end
			end
		end
	end
end

local function createESP(other)
	if other==Player or not other.Character then return end

	local character=other.Character
	local head=character:FindFirstChild("Head")
	local root=character:FindFirstChild("HumanoidRootPart")
	if not head then return end

	local old=character:FindFirstChild("RAN_ESP")
	if old then old:Destroy() end

	local highlight=Instance.new("Highlight")
	highlight.Name="RAN_ESP"
	highlight.FillColor=PURPLE
	highlight.OutlineColor=Color3.new(1,1,1)
	highlight.FillTransparency=.55
	highlight.Parent=character

	local billboard=Instance.new("BillboardGui")
	billboard.Name="RAN_ESP_INFO"
	billboard.Adornee=head
	billboard.Size=UDim2.fromOffset(190,55)
	billboard.StudsOffset=Vector3.new(0,3,0)
	billboard.AlwaysOnTop=true
	billboard.Parent=head

	local name=Instance.new("TextLabel",billboard)
	name.Size=UDim2.new(1,0,.55,0)
	name.BackgroundTransparency=1
	name.Text=other.DisplayName.."  @"..other.Name
	name.TextColor3=Color3.new(1,1,1)
	name.TextStrokeTransparency=.25
	name.TextSize=14
	name.Font=Enum.Font.GothamBold

	local distance=Instance.new("TextLabel",billboard)
	distance.Position=UDim2.new(0,0,.5,0)
	distance.Size=UDim2.new(1,0,.5,0)
	distance.BackgroundTransparency=1
	distance.TextColor3=PURPLE
	distance.TextStrokeTransparency=.3
	distance.TextSize=12
	distance.Font=Enum.Font.GothamMedium

	task.spawn(function()
		while espEnabled and billboard.Parent and character.Parent do
			local myChar=Player.Character
			local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
			local theirRoot=character:FindFirstChild("HumanoidRootPart")

			if myRoot and theirRoot then
				distance.Text=math.floor((myRoot.Position-theirRoot.Position).Magnitude).." studs"
			else
				distance.Text="-- studs"
			end

			task.wait(.15)
		end
	end)
end

local function updateESP()
	removeESP()
	if not espEnabled then return end

	for _,p in ipairs(Players:GetPlayers()) do
		createESP(p)
	end
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		task.wait(.5)
		if espEnabled then createESP(p) end
	end)
end)

