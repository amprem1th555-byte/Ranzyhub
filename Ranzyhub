-- ESP
--==================================================

local espFolder = Instance.new("Folder")
espFolder.Name = "VD_AdminESP"
espFolder.Parent = gui

local espObjects = {}

local function ClearESP()

	for _, obj in pairs(espObjects) do
		if obj then
			obj:Destroy()
		end
	end

	espObjects = {}

end

local function MakeESP(obj, label)

	if not obj then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "VD_ESP"
	highlight.FillColor = BLUE
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = WHITE
	highlight.OutlineTransparency = 0
	highlight.Adornee = obj
	highlight.Parent = espFolder

	espObjects[obj] = highlight

end

local function RefreshESP()

	ClearESP()

	-- Players
	for _, target in ipairs(Players:GetPlayers()) do

		if target ~= player and target.Character then

			local role = target:GetAttribute("Role")

			if role == "Survivor" and ESP.Survivor then
				MakeESP(target.Character, "Survivor")
			end

			if role == "Killer" and ESP.Killer then
				MakeESP(target.Character, "Killer")
			end

		end

	end

	-- Map objects
	local tags = {
		Hook = "Hook",
		Generator = "Generator",
		Pallet = "Pallet",
		Window = "Window",
		SCP = "SCP",
		Zombie = "Zombie",
		Gate = "Gate"
	}

	for tag, setting in pairs(tags) do

		if ESP[setting] then

			for _, obj in ipairs(
				CollectionService:GetTagged(tag)
			) do

				MakeESP(obj, tag)

			end

		end

	end

end

local function ESPButton(tag)

	local button = Button("👁 ESP " .. string.upper(tag), function(b)

		ESP[tag] = not ESP[tag]

		RefreshESP()

		Toggle(
			b,
			"👁 ESP " .. string.upper(tag),
			ESP[tag]
		)

	end)

	return button
end

