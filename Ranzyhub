local function ChangeSpeed(x)

	local percent = math.clamp(
		(x - slider.AbsolutePosition.X) /
			slider.AbsoluteSize.X,
		0,
		1
	)

	WalkSpeed = math.floor(
		1 + percent * (MaxWalkSpeed - 1)
	)

	speedValue.Text = tostring(WalkSpeed)

	fill.Size = UDim2.new(percent, 0, 1, 0)
	knob.Position = UDim2.new(percent, -9, 0.5, -9)

	local hum = Humanoid()

	if hum then
		hum.WalkSpeed = WalkSpeed
	end
end

