local function TeleportToRole(role)

	local target = GetTarget(role)

	if target and Root() then

		Root().CFrame =
			target.CFrame + Vector3.new(0, 3, 0)

	end

end

local tpSurvivor = Button(
	"→ TELEPORT SURVIVOR",
	function()
		TeleportToRole("Survivor")
	end
)

local tpKiller = Button(
	"→ TELEPORT KILLER",
	function()
		TeleportToRole("Killer")
	end
)

local tpGate = Button(
	"→ TELEPORT GATE",
	function()

		local gates =
			CollectionService:GetTagged("Gate")

		if #gates > 0 and Root() then

			local gate = gates[1]

			if gate:IsA("BasePart") then
				Root().CFrame =
					gate.CFrame + Vector3.new(0, 3, 0)

			elseif gate:IsA("Model") then

				local part =
					gate.PrimaryPart
					or gate:FindFirstChildWhichIsA(
						"BasePart"
					)

				if part then
					Root().CFrame =
						part.CFrame +
						Vector3.new(0, 3, 0)
				end

			end

		end

	end
)

