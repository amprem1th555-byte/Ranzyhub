local y = 10

local function Button(text, callback)
	local b = Instance.new("TextButton")

	b.Size = UDim2.new(1, -20, 0, 42)
	b.Position = UDim2.fromOffset(10, y)
	b.BackgroundColor3 = BUTTON
	b.BorderSizePixel = 0
	b.Text = text .. "  •  OFF"
	b.TextColor3 = WHITE
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.AutoButtonColor = false
	b.Parent = scroll

	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 9)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(40, 50, 68)
	stroke.Parent = b

	b.MouseButton1Down:Connect(function()
		TweenService:Create(
			b,
			TweenInfo.new(0.08),
			{BackgroundColor3 = BLUE2}
		):Play()
	end)

	b.MouseButton1Up:Connect(function()
		TweenService:Create(
			b,
			TweenInfo.new(0.12),
			{BackgroundColor3 = BUTTON}
		):Play()
	end)

	b.MouseButton1Click:Connect(function()
		callback(b)
	end)

	y += 48

	return b
end

local function Toggle(button, name, value)
	button.Text = name .. (value and "  •  ON" or "  •  OFF")

	TweenService:Create(
		button,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = value and BLUE2 or BUTTON
		}
	):Play()
end

