--==================================================

local function GetTarget(role)

	local myRoot = Root()

	if not myRoot then
		return nil
	end

	local closest = nil
	local distance = math.huge

	for _, target in ipairs(Players:GetPlayers()) do

		if target ~= player then

			local char = target.Character
			local targetRoot =
				char and char:FindFirstChild("HumanoidRootPart")

			if targetRoot then

				local targetRole =
					target:GetAttribute("Role")

				if targetRole == role then

					local d =
						(targetRoot.Position - myRoot.Position).Magnitude

					if d < distance then
						distance = d
						closest = targetRoot
					end

				end

			end

		end

	end

	return closest
end

local aimConnection

local function UpdateAim()

	local target

	if AimSurvivor then
		target = GetTarget("Survivor")
	elseif AimKiller then
		target = GetTarget("Killer")
	end

	if target then

		local camera = workspace.CurrentCamera

		camera.CFrame = CFrame.lookAt(
			camera.CFrame.Position,
			target.Position
		)

	end
end

