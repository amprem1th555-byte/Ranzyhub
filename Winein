		end
	end)

	return Button
end

local function CreateToggle(text, configName, callback)
	local Button = Instance.new("TextButton")
	Button.Parent = Content
	Button.Size = UDim2.new(1, -8, 0, 42)
	Button.BackgroundColor3 = Color3.fromRGB(18, 20, 29)
	Button.Text = ""
	Button.AutoButtonColor = false

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 9)
	Corner.Parent = Button

	local Label = Instance.new("TextLabel")
	Label.Parent = Button
	Label.Position = UDim2.fromOffset(14, 0)
	Label.Size = UDim2.new(1, -75, 1, 0)
	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.TextColor3 = Color3.fromRGB(225, 225, 230)
	Label.Font = Enum.Font.GothamMedium
	Label.TextSize = 13
	Label.TextXAlignment = Enum.TextXAlignment.Left

	local Status = Instance.new("TextLabel")
	Status.Parent = Button
	Status.Size = UDim2.fromOffset(50, 42)
	Status.Position = UDim2.new(1, -58, 0, 0)
	Status.BackgroundTransparency = 1
	Status.Font = Enum.Font.GothamBold
	Status.TextSize = 11

	local function Update()
		local state = Config[configName]

		if state then
			Status.Text = "ON"
			Status.TextColor3 = Color3.fromRGB(170, 100, 255)
			Button.BackgroundColor3 = Color3.fromRGB(29, 22, 42)
		else
			Status.Text = "OFF"
			Status.TextColor3 = Color3.fromRGB(100, 100, 110)
			Button.BackgroundColor3 = Color3.fromRGB(18, 20, 29)
		end
	end

	Button.MouseButton1Click:Connect(function()
		Config[configName] = not Config[configName]
		Update()

		if callback then
			callback(Config[configName])
		end
	end)

	Update()

	return Button
end

