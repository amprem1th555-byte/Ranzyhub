local CurrentTab = "Info"

local function CreateTab(name)
	local Button = Instance.new("TextButton")
	Button.Parent = Sidebar
	Button.Size = UDim2.new(1, 0, 0, 42)
	Button.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
	Button.Text = "   " .. name
	Button.TextColor3 = Color3.fromRGB(210, 210, 220)
	Button.Font = Enum.Font.GothamMedium
	Button.TextSize = 13
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.AutoButtonColor = false

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Button

	Button.MouseButton1Click:Connect(function()
		CurrentTab = name

		for _, b in ipairs(Sidebar:GetChildren()) do
			if b:IsA("TextButton") then
				b.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
			end
		end

		Button.BackgroundColor3 = Color3.fromRGB(35, 25, 50)

		ClearContent()

		-- INFO
		if name == "Info" then
			CreateSection("OWNER / DEBUG PANEL")

			CreateButton("Violence District", function() end)
			CreateButton("Owner ID: " .. OWNER_ID, function() end)
			CreateButton("Welcome, @" .. LocalPlayer.Name, function() end)

		-- PLAYER
		elseif name == "Player" then
			CreateSection("PLAYER")

			CreateToggle("No Clip", "NoClip", function() end)
			CreateToggle("God Mode", "GodMode", function() end)
			CreateToggle("Auto Heal", "AutoHeal", function() end)

			CreateButton("WalkSpeed: " .. Config.WalkSpeed, function()
				Config.WalkSpeed = 50
				SetWalkSpeed()
			end)

			CreateButton("Reset WalkSpeed", function()
				Config.WalkSpeed = 16
				SetWalkSpeed()
			end)

		-- VISUAL
		elseif name == "Visual" then
			CreateSection("ESP")

			CreateToggle("Survivor ESP", "ESP_Survivor", function() end)
			CreateToggle("Killer ESP", "ESP_Killer", function() end)
			CreateToggle("Object ESP", "ESP_Object", function() end)

			CreateSection("VISUAL")

			CreateToggle("Full Bright", "FullBright", function(v)
				SetFullBright(v)
			end)

			CreateToggle("No Fog", "NoFog", function(v)
				Lighting.FogEnd = v and 100000 or 1000
			end)

			CreateToggle("FPS Boost", "FPSBoost", function() end)

		-- GAME
		elseif name == "Game" then
			CreateSection("GAME")

			CreateToggle("Auto Parry", "AutoParry", function() end)
			CreateToggle("Auto Attack", "AutoAttack", function() end)

			CreateButton("Teleport → Spawn", function()
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local spawn = workspace:FindFirstChildOfClass("SpawnLocation")

				if root and spawn then
					root.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end)

			CreateButton("Refresh Character", function()
				LocalPlayer:LoadCharacter()
			end)
		end
	end)

	return Button
end

CreateTab("Info")
