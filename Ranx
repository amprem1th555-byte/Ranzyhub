local function findPlayerByRole(role)
local best, bestDistance = nil, math.huge
local myRoot = getRoot()
if not myRoot then return nil end
for _, p in ipairs(Players:GetPlayers()) do
if p ~= LocalPlayer then
local pRole = p:GetAttribute("Role")
if normalize(pRole) == normalize(role) then
local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
if r then
local d = (r.Position - myRoot.Position).Magnitude
if d < bestDistance then
best, bestDistance = r, d
end
end
end
end
end
return best
end
local function teleportToTag(tag)
local root = getRoot()
if not root then return false end
local objects = CollectionService:GetTagged(tag)
if #objects == 0 then return false end
local target = objects[1]
local part = target:IsA("BasePart") and target
or target:IsA("Model") and (
target.PrimaryPart
or target:FindFirstChildWhichIsA("BasePart")
)
if part then
root.CFrame = part.CFrame + Vector3.new(0,3,0)
return true
end
return false
end
local function teleportToRole(role)
local root = getRoot()
local target = findPlayerByRole(role)
if root and target then
root.CFrame = target.CFrame + Vector3.new(0,3,0)
return true
end
return false
end
