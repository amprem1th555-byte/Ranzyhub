local function detectType(object)
if not object then return nil end
local tagMap = {
Survivor="Survivor", Killer="Killer", Generator="Generator",
Hook="Hook", Pallet="Pallet", Window="Window",
SCP="SCP", Zombie="Zombie", Gate="Gate"
}
for tag, typ in pairs(tagMap) do
if CollectionService:HasTag(object, tag) then
return typ
end
end
for _, attr in ipairs({
"Role","Type","ObjectType","EntityType","Class","Category","Team"
}) do
local value = object:GetAttribute(attr)
if value then
local n = normalize(value)
if n:find("survivor") then return "Survivor" end
if n:find("killer") then return "Killer" end
if n:find("generator") or n == "gen" then return "Generator" end
if n:find("hook") then return "Hook" end
if n:find("pallet") then return "Pallet" end
if n:find("window") or n:find("vault") then return "Window" end
if n:find("scp") then return "SCP" end
if n:find("zombie") or n:find("undead") then return "Zombie" end
if n:find("gate") or n:find("exit") or n:find("escape") then return "Gate" end
end
end
local names = {object.Name}
if object.Parent then table.insert(names, object.Parent.Name) end
for _, raw in ipairs(names) do
local n = normalize(raw)
if n:find("survivor") then return "Survivor" end
if n:find("killer") then return "Killer" end
if n:find("generator") or n == "gen" then return "Generator" end
if n:find("hook") then return "Hook" end
if n:find("pallet") then return "Pallet" end
if n:find("window") or n:find("vault") then return "Window" end
if n:find("scp") then return "SCP" end
if n:find("zombie") or n:find("undead") then return "Zombie" end
if n:find("gate") or n:find("exit") or n:find("escape") then return "Gate" end
end
return nil
end
local function getAdornee(object)
if object:IsA("Model") then return object end
return object:FindFirstAncestorOfClass("Model") or object
end
local function removeESP(object)
local data = espObjects[object]
if not data then return end
if data.highlight then data.highlight:Destroy() end
if data.billboard then data.billboard:Destroy() end
espObjects[object] = nil
end
local function createESP(object, typ)
if not object or espObjects[object] then return end
local adornee = getAdornee(object)
if not adornee then return end
local highlight = Instance.new("Highlight")
highlight.Name = "VD_ESP"
highlight.FillColor = colors[typ] or Color3.fromRGB(0,140,255)
highlight.FillTransparency = 0.72
highlight.OutlineColor = colors[typ] or Color3.new(1,1,1)
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
highlight.Adornee = adornee
highlight.Parent = espFolder
local root = adornee:IsA("Model")
and (adornee:FindFirstChild("HumanoidRootPart")
or adornee.PrimaryPart
or adornee:FindFirstChildWhichIsA("BasePart"))
or (adornee:IsA("BasePart") and adornee)
local billboard, label
if root then
billboard = Instance.new("BillboardGui")
billboard.Name = "VD_ESP_INFO"
billboard.Size = UDim2.fromOffset(190,55)
billboard.StudsOffset = Vector3.new(0,3.5,0)
billboard.AlwaysOnTop = true
billboard.Adornee = root
billboard.Parent = espFolder
label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1,1)
label.BackgroundTransparency = 1
label.TextColor3 = colors[typ] or Color3.new(1,1,1)
label.TextStrokeTransparency = 0
label.Font = Enum.Font.GothamBold
label.TextSize = 12
label.Text = typ
label.Parent = billboard
end
espObjects[object] = {
highlight = highlight,
billboard = billboard,
label = label,
type = typ,
}
end
local function refreshESP()
for object in pairs(espObjects) do
removeESP(object)
end
if not Config.ESP then return end
for _, p in ipairs(Players:GetPlayers()) do
if p ~= LocalPlayer and p.Character then
local role = p:GetAttribute("Role") or p.Character:GetAttribute("Role")
local typ
if normalize(role) == "survivor" then typ = "Survivor" end
if normalize(role) == "killer" then typ = "Killer" end
if typ and Config.ESP[typ] then
createESP(p.Character, typ)
end
end
end
local tags = {"Generator","Hook","Pallet","Window","SCP","Zombie","Gate"}
for _, tag in ipairs(tags) do
if Config.ESP[tag] then
for _, obj in ipairs(CollectionService:GetTagged(tag)) do
createESP(obj, tag)
end
end
end
for _, obj in ipairs(workspace:GetDescendants()) do
if obj:IsA("Model") or obj:IsA("BasePart") then
local typ = detectType(obj)
if typ and Config.ESP[typ] then
createESP(obj, typ)
end
end
end
end
local function updateESP()
local myRoot = getRoot()
if not myRoot then return end
for object, data in pairs(espObjects) do
if not object.Parent then
removeESP(object)
continue
end
local adornee = getAdornee(object)
local root = adornee and (
adornee:FindFirstChild("HumanoidRootPart")
or adornee.PrimaryPart
or adornee:FindFirstChildWhichIsA("BasePart")
)
if root and data.label then
local text = data.type
if Config.ESP.Distance then
text ..= "\n" .. math.floor(
(root.Position - myRoot.Position).Magnitude
) .. " studs"
end
if Config.ESP.Health and adornee:IsA("Model") then
local hum = adornee:FindFirstChildOfClass("Humanoid")
if hum then
text ..= "\nHP: "
.. math.floor(hum.Health)
.. "/"
.. math.floor(hum.MaxHealth)
end
end
data.label.Text = text
end
end
end
