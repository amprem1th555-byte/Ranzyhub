local function addSlider()
	local card = addCard(78)

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Position = UDim2.fromOffset(16, 8)
	valueLabel.Size = UDim2.new(1, -32, 0, 25)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = "WalkSpeed                         16"
	valueLabel.TextColor3 = TEXT
	valueLabel.TextSize = 15
	valueLabel.Font = Enum.Font.GothamMedium
	valueLabel.TextXAlignment = Enum.TextXAlignment.Left
	valueLabel.Parent = card

	local bar = Instance.new("Frame")
	bar.Position = UDim2.fromOffset(16, 47)
	bar.Size = UDim2.new(1, -32, 0, 7)
	bar.BackgroundColor3 = Color3.fromRGB(50, 51, 60)
	bar.BorderSizePixel = 0
	bar.Parent = card

	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((16 - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0, 1, 0)
	fill.BackgroundColor3 = PURPLE
	fill.BorderSizePixel = 0
	fill.Parent = bar

	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.fromOffset(19, 19)
	knob.Position = UDim2.new((16 - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), -9, 0.5, -9)
	knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
	knob.Text = ""
	knob.Parent = bar

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local dragging = false

	local function setValue(x)
		local percent = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		local value = math.floor(
			MIN_SPEED + percent * (MAX_SPEED - MIN_SPEED) + 0.5
		)

		fill.Size = UDim2.new(percent, 0, 1, 0)
		knob.Position = UDim2.new(percent, -9, 0.5, -9)
		valueLabel.Text = "WalkSpeed                         " .. value

		local hum = getHumanoid()
		if hum then
			hum.WalkSpeed = value
		end
	end

	knob.MouseButton1Down:Connect(function()
		dragging = true
	end)

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setValue(input.Position.X)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			setValue(input.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return card
end

