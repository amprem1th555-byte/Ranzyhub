local function addToggle(text, callback)
	local card = addCard(52)

	local label = Instance.new("TextLabel")
	label.Position = UDim2.fromOffset(16, 0)
	label.Size = UDim2.new(1, -75, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = TEXT
	label.TextSize = 15
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = card

	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(48, 27)
	button.Position = UDim2.new(1, -62, 0.5, -13)
	button.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
	button.Text = ""
	button.Parent = card

	Instance.new("UICorner", button).CornerRadius = UDim.new(1, 0)

	local circle = Instance.new("Frame")
	circle.Size = UDim2.fromOffset(21, 21)
	circle.Position = UDim2.fromOffset(3, 3)
	circle.BackgroundColor3 = Color3.fromRGB(225, 225, 225)
	circle.Parent = button

	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local enabled = false

	button.MouseButton1Click:Connect(function()
		enabled = not enabled

		if enabled then
			button.BackgroundColor3 = PURPLE
			circle.Position = UDim2.new(1, -24, 0, 3)
		else
			button.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
			circle.Position = UDim2.fromOffset(3, 3)
		end

		if callback then
			callback(enabled)
		end
	end)

	return card
end

